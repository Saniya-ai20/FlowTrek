// File Path: /api/expenses.js
export default function handler(req, res) {
  // CORS Headers for Frontend Connection
  res.setHeader('Access-Control-Allow-Credentials', true);
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET,OPTIONS,POST,DELETE');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    res.status(200).end();
    return;
  }

  if (req.method === 'GET') {
    // Return Expenses Array
    res.status(200).json({
      status: "success",
      data: [
        { id: 'exp_b1', amount: 1450, category: 'food', description: 'Weekly Grocery at Nature Basket', date: '2026-07-20', method: 'UPI' },
        { id: 'exp_b2', amount: 3200, category: 'bills', description: 'Electricity & Internet Bill', date: '2026-07-18', method: 'Paytm' },
        { id: 'exp_b3', amount: 4500, category: 'shopping', description: 'Zara Summer Wear', date: '2026-07-15', method: 'PhonePe' },
        { id: 'exp_b4', amount: 12500, category: 'travel', description: 'Goa Flight Tickets', date: '2026-07-10', method: 'PayPal' }
      ]
    });
  } else if (req.method === 'POST') {
    const newExpense = req.body || {};
    res.status(201).json({
      status: "created",
      message: "Expense added to database successfully",
      expense: { id: "exp_" + Date.now(), ...newExpense }
    });
  } else {
    res.status(405).json({ error: "Method not allowed" });
  }
}
